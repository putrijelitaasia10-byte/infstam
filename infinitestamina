-- Forsaken | Infinite Stamina
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local Sprinting, enabled, hooked, origInit

task.spawn(function()
    while not Sprinting do
        local ok, m = pcall(require, RS:WaitForChild("Systems", 10)
            :WaitForChild("Character", 10)
            :WaitForChild("Game", 10)
            :WaitForChild("Sprinting", 10))
        if ok and type(m) == "table" then Sprinting = m
        else task.wait(0.5) end
    end
end)

local function on()
    if not Sprinting then return end
    if not hooked then
        origInit = Sprinting.Init
        local old = origInit
        Sprinting.Init = function(...)
            local r = old(...)
            Sprinting.StaminaLossDisabled = true
            return r
        end
        hooked = true
    end
    Sprinting.StaminaLossDisabled = true
end

local function off()
    if not Sprinting then return end
    if hooked and origInit then
        Sprinting.Init = origInit
        hooked = false
        origInit = nil
    end
    Sprinting.StaminaLossDisabled = false
end

