-- toggle behavior
local function refresh()
    toggle.Text = "Infinite Stamina: " .. (enabled and "ON" or "OFF")
    toggle.TextColor3 = enabled
        and Color3.fromRGB(140, 230, 160)
        or Color3.fromRGB(200, 200, 210)
end

toggle.MouseButton1Click:Connect(function()
    enabled = not enabled
    refresh()
    if enabled then
        task.spawn(function()
            while not Sprinting do task.wait(0.25) end
            if enabled then on() end
        end)
    else
        off()
    end
end)

-- open/close
pill.MouseButton1Click:Connect(function()
    panel.Position = pill.Position
    pill.Visible = false
    panel.Visible = true
end)

close.MouseButton1Click:Connect(function()
    pill.Position = panel.Position
    panel.Visible = false
    pill.Visible = true
end)

-- drag (works on both pill and panel)
local function makeDrag(handle)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = i.Position
            startPos = handle.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - dragStart
            handle.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

makeDrag(pill)
makeDrag(panel)
